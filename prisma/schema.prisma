// SVARGA Admin Dashboard — Prisma schema (PostgreSQL)
//
// Superset dari src/db/schema.sql milik Web-App Pengguna — tabel inti
// (green_space, koridor, sensor_devices/readings, mood_logs, geofences,
// umkms, bfest) sama persis, supaya kedua aplikasi bisa membaca database
// yang sama. Ditambah beberapa tabel khusus Admin: admin_users,
// notifications, integration_settings, dan PostGIS untuk Sociotope
// Mood Map (Pekan 8).
//
// Cara pakai (harus dijalankan di komputer sendiri — sandbox pembuatan
// project ini tidak bisa mengunduh binary Prisma):
//   1. Isi DATABASE_URL di .env
//   2. npx prisma generate
//   3. npx prisma migrate dev --name init
//   4. npx prisma db seed   (lihat prisma/seed.js)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("admin") // admin | super_admin
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

model GreenSpace {
  id           Int      @id @default(autoincrement())
  name         String
  locationType String?  @map("location_type")
  description  String?
  latitude     Decimal  @db.Decimal(9, 6)
  longitude    Decimal  @db.Decimal(9, 6)
  address      String?
  shadeScore   Float?   @map("shade_score")
  isActive     Boolean  @default(true) @map("is_active")

  koridors      Koridor[]
  sensorDevices SensorDevice[]
  geofences     Geofence[]
  events        Event[]
  umkms         Umkm[]
  moodLogs      MoodLog[]

  @@map("green_space")
}

model Koridor {
  id               Int      @id @default(autoincrement())
  greenSpaceId     Int?     @map("green_space_id")
  koridorName      String   @map("koridor_name")
  shortName        String?  @map("short_name")
  routeLabel       String?  @map("route_label")
  hijauLevel       String?  @map("hijau_level")
  hijauScore       Int?     @map("hijau_score")
  distanceMeter    Float?   @map("distance_meter")
  estimateMinutes  Int?     @map("estimate_minutes")
  shadeScore       Float?   @map("shade_score")
  airQualityScore  Float?   @map("air_quality_score")
  noiseScore       Float?   @map("noise_score")
  comfortScore     Float?   @map("comfort_score")
  status           String?  @default("rencana")
  createdAt        DateTime @default(now()) @map("created_at")

  greenSpace GreenSpace? @relation(fields: [greenSpaceId], references: [id])
  umkms      Umkm[]

  @@map("koridor")
}

model SensorDevice {
  id           Int       @id @default(autoincrement())
  greenSpaceId Int?      @map("green_space_id")
  deviceCode   String    @unique @map("device_code")
  deviceType   String?   @map("device_type")
  locationName String?   @map("location_name")
  isActive     Boolean   @default(true) @map("is_active")
  needsRepair  Boolean   @default(false) @map("needs_repair")
  lastSeenAt   DateTime? @map("last_seen_at")

  greenSpace GreenSpace?    @relation(fields: [greenSpaceId], references: [id])
  readings   SensorReading[]

  @@map("sensor_devices")
}

model SensorReading {
  id         BigInt   @id @default(autoincrement())
  deviceId   Int      @map("device_id")
  metricType String   @map("metric_type") // aqi | suhu | kelembaban | kebisingan | uv
  value      Float
  status     String?
  recordedAt DateTime @default(now()) @map("recorded_at")

  device SensorDevice @relation(fields: [deviceId], references: [id])

  @@index([deviceId, recordedAt])
  @@map("sensor_readings")
}

model MoodLog {
  id                 BigInt   @id @default(autoincrement())
  greenSpaceId       Int?     @map("green_space_id")
  moodScore          Int // 1..5
  anonymousSessionId String?  @map("anonymous_session_id")
  activity           String?
  note               String?
  loggedAt           DateTime @default(now()) @map("logged_at")

  greenSpace GreenSpace? @relation(fields: [greenSpaceId], references: [id])

  @@map("mood_logs")
}

model Geofence {
  id            Int      @id @default(autoincrement())
  greenSpaceId  Int?     @map("green_space_id")
  soundscapeId  Int?     @map("soundscape_id")
  name          String
  location      String?
  areaHectare   Float?   @map("area_hectare")
  latitude      Decimal  @db.Decimal(9, 6)
  longitude     Decimal  @db.Decimal(9, 6)
  radiusMeter   Float    @default(50) @map("radius_meter")
  broadcastType String?  @map("broadcast_type") // "Audio & Info" | "Audio & Musik" | dst.
  isActive      Boolean  @default(true) @map("is_active")
  welcomeTitle  String?  @map("welcome_title")
  welcomeDesc   String?  @map("welcome_desc")

  greenSpace GreenSpace? @relation(fields: [greenSpaceId], references: [id])

  @@map("geofences")
}

model Umkm {
  id           Int     @id @default(autoincrement())
  greenSpaceId Int?    @map("green_space_id")
  koridorId    Int?    @map("koridor_id")
  businessName String  @map("business_name")
  businessType String? @map("business_type")
  address      String?
  distanceM    Int?    @map("distance_m")
  rating       Float?
  isActive     Boolean @default(true) @map("is_active")

  greenSpace GreenSpace? @relation(fields: [greenSpaceId], references: [id])
  koridor    Koridor?    @relation(fields: [koridorId], references: [id])

  @@map("umkms")
}

model Event {
  id           Int      @id @default(autoincrement())
  greenSpaceId Int?     @map("green_space_id")
  title        String
  description  String?
  eventDate    DateTime @map("event_date")
  startTime    String?  @map("start_time")
  endTime      String?  @map("end_time")
  routeInfo    String?  @map("route_info")
  routeCount   Int?     @map("route_count")
  notifSent    Int?     @map("notif_sent")
  umkmCount    Int?     @map("umkm_count")
  imageUrl     String?  @map("image_url")
  isActive     Boolean  @default(true) @map("is_active")

  greenSpace GreenSpace? @relation(fields: [greenSpaceId], references: [id])

  @@map("events")
}

model AppUser {
  id         Int       @id @default(autoincrement())
  name       String
  email      String    @unique
  role       String    @default("warga") // warga | admin
  status     String    @default("aktif") // aktif | nonaktif
  avatarUrl  String?   @map("avatar_url")
  joinedAt   DateTime  @default(now()) @map("joined_at")
  lastActiveAt DateTime? @map("last_active_at")

  @@map("app_users")
}

model NotificationLog {
  id          Int      @id @default(autoincrement())
  category    String // lingkungan | festival | sensor | pengguna
  title       String
  description String?
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("notification_logs")
}

model IntegrationSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique // kalender_bwi | sensor_iot | geofencing | email
  label       String
  description String?
  isConnected Boolean  @default(false) @map("is_connected")
  config      Json?

  @@map("integration_settings")
}

// ---------------------------------------------------------
// Sociotope Mood Map (Pekan 8) — butuh ekstensi PostGIS:
//   CREATE EXTENSION IF NOT EXISTS postgis;
// Prisma belum mendukung tipe geometry secara native, jadi kolom lokasi
// disimpan sbg raw geometry lewat Unsupported() dan diquery lewat
// $queryRaw di service Sociotope (lihat lib/services/sociotopeService.js).
// ---------------------------------------------------------
model SociotopePoint {
  id         BigInt                   @id @default(autoincrement())
  moodScore  Int                      @map("mood_score")
  location   Unsupported("geometry(Point, 4326)")
  recordedAt DateTime                 @default(now()) @map("recorded_at")

  @@map("sociotope_points")
}
